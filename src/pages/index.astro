---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts.js';
import { getSortedPosts } from '../utils/posts.js';
import { DATE_FORMATTER } from '../utils/date.js';

const posts = await getSortedPosts();
---
<BaseLayout title={SITE.title} description={SITE.description}>
  {posts.map(post => (
    <article class="post-summary">
      <h3 class="post-summary__title">
        <a href={`/${post.id}/`}>{post.data.title}</a>
      </h3>
      <small class="post-summary__date">{DATE_FORMATTER.format(post.data.date)}</small>
    </article>
  ))}

  <a rel="me" href="https://mastodon.xyz/@mab" class="mastodon-webfinger">&nbsp;</a>
</BaseLayout>
