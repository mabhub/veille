---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdjacentPostLink from '../components/AdjacentPostLink.astro';
import SourceLink from '../components/SourceLink.astro';
import { getSortedPosts } from '../utils/posts.js';
import { DATE_FORMATTER } from '../utils/date.js';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previous: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const excerpt = post.body.replace(/\s+/g, ' ').slice(0, 160);
---
<BaseLayout title={post.data.title} description={excerpt}>
  <h1>{post.data.title}</h1>
  <p class="post-date">{DATE_FORMATTER.format(post.data.date)}</p>

  <article class="prose">
    <Content />
  </article>

  <nav class="post-nav" aria-label="Navigation entre les articles">
    <hr />
    <ul class="nav-list">
      <AdjacentPostLink direction="prev" post={previous} />
      <AdjacentPostLink direction="next" post={next} />
    </ul>
  </nav>

  <SourceLink file={`${post.id}.md`} />
</BaseLayout>
